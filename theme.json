{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1312px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "primary", "name": "Dermatex Dark Blue", "color": "#111B2E" },
				{ "slug": "silver", "name": "Dermatex Silver", "color": "#A3A3A3" },
				{ "slug": "gold", "name": "Dermatex Gold", "color": "#E6C278" },
				{ "slug": "ink", "name": "Ink", "color": "#111B2E" },
				{ "slug": "muted", "name": "Muted", "color": "#39393A" },
				{ "slug": "canvas", "name": "Canvas", "color": "#FAF8F0" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "soft", "name": "Soft", "color": "#F7ECD6" },
				{ "slug": "grey", "name": "Dermatex Grey", "color": "#A3A3A3" },
				{ "slug": "success", "name": "Success", "color": "#276344" },
				{ "slug": "error", "name": "Error", "color": "#A13832" },
				{ "slug": "hover", "name": "Hover", "color": "#39393A" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "dm-serif-display",
					"name": "DM Serif Display",
					"fontFamily": "\"DM Serif Display\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "DM Serif Display",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/dm-serif-display-latin-400-normal.woff2"]
						}
					]
				},
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/manrope-latin-400-normal.woff2"]
						},
						{
							"fontFamily": "Manrope",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/manrope-latin-700-normal.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "eyebrow", "name": "Eyebrow", "size": "12px" },
				{ "slug": "caption", "name": "Caption", "size": "14px" },
				{ "slug": "body", "name": "Body", "size": "18px", "fluid": { "min": "16px", "max": "18px" } },
				{ "slug": "heading-6", "name": "H6", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "slug": "heading-5", "name": "H5", "size": "24px", "fluid": { "min": "20px", "max": "24px" } },
				{ "slug": "heading-4", "name": "H4", "size": "28px", "fluid": { "min": "24px", "max": "28px" } },
				{ "slug": "heading-3", "name": "H3", "size": "36px", "fluid": { "min": "28px", "max": "36px" } },
				{ "slug": "heading-2", "name": "H2", "size": "48px", "fluid": { "min": "32px", "max": "48px" } },
				{ "slug": "heading-1", "name": "H1", "size": "64px", "fluid": { "min": "40px", "max": "64px" } }
			]
		},
		"spacing": {
			"units": ["px", "%", "rem", "vw"],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "4", "size": "4px" },
				{ "slug": "20", "name": "8", "size": "8px" },
				{ "slug": "30", "name": "12", "size": "12px" },
				{ "slug": "40", "name": "16", "size": "16px" },
				{ "slug": "50", "name": "24", "size": "24px" },
				{ "slug": "60", "name": "32", "size": "32px" },
				{ "slug": "70", "name": "48", "size": "48px" },
				{ "slug": "80", "name": "64", "size": "64px" },
				{ "slug": "90", "name": "80", "size": "80px" },
				{ "slug": "100", "name": "96", "size": "96px" }
			]
		},
		"border": { "radius": true, "color": true, "style": true, "width": true },
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "raised", "name": "Raised card", "shadow": "0 4px 16px rgba(17, 27, 46, 0.08)" }
			]
		},
		"custom": {
			"radius": { "control": "8px", "card": "16px" },
			"control-height": "48px",
			"section-space": { "desktop": "96px", "mobile": "64px" }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.667"
		},
		"spacing": {
			"padding": {
				"left": "clamp(20px, 5.2vw, 64px)",
				"right": "clamp(20px, 5.2vw, 64px)"
			},
			"blockGap": "24px"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--hover)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--dm-serif-display)",
					"fontWeight": "400"
				}
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-1)", "lineHeight": "1.125", "letterSpacing": "0.02em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-2)", "lineHeight": "1.21", "letterSpacing": "0.01em" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "lineHeight": "1.28", "letterSpacing": "0.005em" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-4)", "lineHeight": "1.36", "letterSpacing": "0" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-5)", "lineHeight": "1.42", "letterSpacing": "0" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-6)", "lineHeight": "1.4", "letterSpacing": "0" }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--surface)" },
				"border": { "radius": "8px" },
				"typography": { "fontSize": "16px", "fontWeight": "700", "lineHeight": "1.5", "textDecoration": "none" },
				"spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "32px", "right": "32px" } },
				":hover": {
					"color": { "background": "var(--wp--preset--color--hover)", "text": "var(--wp--preset--color--surface)" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"secondary": {
						"color": { "background": "var(--wp--preset--color--silver)", "text": "var(--wp--preset--color--primary)" },
						"border": { "color": "var(--wp--preset--color--primary)", "width": "1px", "style": "solid" },
						":hover": {
							"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--surface)" }
						}
					},
					"gold": {
						"color": { "background": "var(--wp--preset--color--gold)", "text": "var(--wp--preset--color--primary)" },
						":hover": {
							"color": { "background": "var(--wp--preset--color--surface)", "text": "var(--wp--preset--color--primary)" }
						}
					}
				}
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-serif-display)" }
			},
			"core/image": {
				"border": { "radius": "16px" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--grey)" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--dm-serif-display)", "fontSize": "var(--wp--preset--font-size--heading-4)", "lineHeight": "1.36" },
				"border": { "width": "0" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "cta-banner", "title": "Call-to-action band", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Full-width page (no title)", "postTypes": ["page"] },
		{ "name": "subpage-info", "title": "Subpage: Informational", "postTypes": ["page"] },
		{ "name": "subpage-media", "title": "Subpage: Media & stories", "postTypes": ["page"] },
		{ "name": "subpage-service", "title": "Subpage: Service", "postTypes": ["page"] }
	]
}
